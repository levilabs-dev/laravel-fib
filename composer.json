{
    "name": "levilabs/laravel-fib",
    "description": "Modern Laravel SDK for First Iraqi Bank (FIB): online payments and payouts, with typed DTOs, multi-account support, and webhook-safe status verification.",
    "keywords": [
        "laravel",
        "fib",
        "first-iraqi-bank",
        "payment",
        "payout",
        "sdk",
        "iraq",
        "levilabs"
    ],
    "homepage": "https://levilabs.dev",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/levilabs-dev/laravel-fib/issues",
        "source": "https://github.com/levilabs-dev/laravel-fib",
        "docs": "https://github.com/levilabs-dev/laravel-fib#readme",
        "security": "https://github.com/levilabs-dev/laravel-fib/security"
    },
    "authors": [
        {
            "name": "Levi Labs",
            "email": "hello@levilabs.dev",
            "homepage": "https://levilabs.dev",
            "role": "Organization"
        },
        {
            "name": "Nizam Omer",
            "email": "nizam@nizaamomer.com",
            "homepage": "https://nizaamomer.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "LeviLabs\\LaravelFib\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LeviLabs\\LaravelFib\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "LeviLabs\\LaravelFib\\FibServiceProvider"
            ],
            "aliases": {
                "FibPayment": "LeviLabs\\LaravelFib\\Facades\\FibPayment",
                "FibPayout": "LeviLabs\\LaravelFib\\Facades\\FibPayout"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
